# Kora 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=xxx
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# api.deepseek.com 的限时客服调用默认关闭思考，避免占满 JSON/正文的输出预算。
# 辅助调用（意图识别、查询改写与重排、记忆摘要和画像）使用的模型；留空与主模型相同。
KORA_FAST_MODEL=

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=kora123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:kora123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 本地降级路径（仅 development；production 连接失败时中止启动）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
KORA_SEED_DEMO_DOCS=true

# ── 向量与检索 ───────────────────────────────────────────────────────────────
# bge-m3：本地多语言模型，中英文通用，约占 1GB 内存；chroma：沿用 ChromaDB 默认模型（不适合中文）。
KORA_EMBEDDING_PROVIDER=bge-m3
KORA_EMBEDDING_THREADS=2
# 低于该余弦相似度的片段不返回给 Agent（仅 bge-m3）。调高会误伤英文提问。
KORA_KB_MIN_SCORE=0.40
# 查询改写和 LLM 重排各增加一次模型调用；评测显示换模型后收益很小，默认关闭。
KORA_RAG_REWRITE=false
KORA_RAG_RERANK=false
# 转人工时告诉用户怎么联系人工客服，例如“在线客服每天 9:00–21:00，电话 400-xxx-xxxx”；留空则只提示走官方渠道。
KORA_HANDOFF_CONTACT=
# 回答前先检索一次知识库，多数问题可省一轮模型调用；超时或失败时由 Agent 自行检索。
KORA_PREFETCH_KNOWLEDGE=true
KORA_PREFETCH_TIMEOUT_S=2

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 每次模型请求的超时（秒）；聊天请求另有 50 秒总预算。
KORA_INTENT_TIMEOUT_S=8
# 意图识别的输出上限与思考强度（low/medium/high，留空用模型默认；仅对支持 effort 的 Claude 模型生效）。
KORA_INTENT_MAX_TOKENS=1024
KORA_INTENT_EFFORT=low
KORA_LLM_TIMEOUT_S=15
KORA_COMPOSER_TIMEOUT_S=8
# 普通后台画像的最短更新间隔；明确表达偏好时立即更新。设 0 恢复逐轮更新。
PROFILE_UPDATE_MIN_INTERVAL_S=60

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,kora,kora:*,kora-python,kora-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
KORA_ENV=development
# KORA_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_ENABLED=true
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=
